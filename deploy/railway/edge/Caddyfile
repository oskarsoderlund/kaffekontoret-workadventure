:8080 {
	encode zstd gzip
	log {
		output stdout
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Sec-Websocket-Key delete
			request>headers>Sec-Websocket-Protocol delete
			request>headers>X-Api-Key delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			resp_headers>Sec-WebSocket-Protocol delete
			resp_headers>Set-Cookie delete
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>uri query {
				replace roomId REDACTED
				delete characterTextureIds
				delete chatID
				delete roomName
				delete tabId
				delete lastReceivedNonce
			}
			wrap json
		}
	}

	handle /health {
		header Content-Type application/json
		respond "{\"status\":\"ok\",\"service\":\"kk-wa-edge\",\"upstream\":\"9eaac2d8683f62d87b1aef9d1014fb6d62b4ba35\",\"commit\":\"{$RAILWAY_GIT_COMMIT_SHA}\"}" 200
	}

	@websocket path /ws/*
	handle @websocket {
		reverse_proxy {$WA_PLAY_HOST}:3001
	}

	# Pilot APIs keep their /api/pilot prefix; the generic WorkAdventure back route strips /api.
	handle /api/pilot/* {
		reverse_proxy {$WA_PILOT_BACKEND_HOST}:3000
	}

	handle_path /api/* {
		reverse_proxy {$WA_BACK_HOST}:8080
	}

	handle_path /map-storage/* {
		reverse_proxy {$WA_MAP_STORAGE_HOST}:3000
	}

	handle_path /icon/* {
		reverse_proxy {$WA_ICON_HOST}:8080
	}

	handle /lettericons/* {
		reverse_proxy {$WA_ICON_HOST}:8080
	}

	handle {
		reverse_proxy {$WA_PLAY_HOST}:3000
	}
}
